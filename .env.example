# Server Port (default: 3000)
PORT=3000

# Session Secret: Random secret key used to sign session cookies (e.g. any secure random string)
SESSION_SECRET="your_session_secret_key_here"

# MySQL Database Configuration
# Hostname or IP of your MySQL server (e.g., localhost or 127.0.0.1)
MYSQL_HOST="localhost"
# Port for MySQL service (default: 3306)
MYSQL_PORT="3306"
# MySQL username (e.g., root)
MYSQL_USER="root"
# MySQL user password
MYSQL_PASSWORD="your_mysql_password"
# MySQL database name (e.g., resumecraft_db)
MYSQL_DATABASE="resumecraft_db"

# Google Gemini API Key: Required for AI resume improvements, keyword suggestions, and roadmaps
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
